# Version-control internals and publication-only reports.
.git
.gitignore
.worktrees/
/.hermes/
/.cursorrules
/AGENTS.md
/CLAUDE.md
/notes/

# Credentials and host-specific authentication state.
.env
.env.*
**/.env
**/.env.*
.netrc
**/.netrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*
**/secrets*

# Host virtual environments and caches.
.venv/
.venv-*/
**/.venv/
**/.venv-*/
venv/
**/venv/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.cache/
**/.cache/
__pycache__/
**/__pycache__/
**/*.py[cod]

# Local build products and unpublished binary trees. The reviewed AOT cubins
# under banana-smasher/kernels remain part of the public source context.
/build/
**/build/
/dist/
**/dist/
*.egg-info/
**/*.egg-info/
*.whl
**/*.whl
**/*.so
**/*.dylib
**/*.dll
**/*.a
**/*.o
/artifacts/
/wheels/
/wheelhouse/
/frozen/
/private/
/runtime-private/

# Host patches are excluded; docker/patches is reviewed repository source.
/patches/
/host-patches/
/private-patches/

# Model data and exported packs never belong in an image build context.
/model/
/models/
/model-data/
/packs/
*.gguf
**/*.gguf
*.safetensors
**/*.safetensors
*.pt
**/*.pt
*.bin
**/*.bin
*.onnx
**/*.onnx

.DS_Store
