{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-other-github-account/banana-smasher/blob/main/evaluations/schemas/balanced64-suite-lock-v1.schema.json",
  "title": "Banana Smasher BALANCED64 public suite lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "name", "fp", "wire_parameter_denominator", "window_count",
    "positions_per_window", "positions", "support", "teacher_bank",
    "teacher_source_model_index_sha256", "source_suite_sha256",
    "source_windows_sha256", "source_provenance_sha256",
    "window_population_sha256", "class_map_sha256", "retired_class_map",
    "class_windows", "metrics", "windows", "canonicalization", "suite_lock_sha256"
  ],
  "properties": {
    "schema": {"const": "banana-smasher.balanced64-suite-lock.v1"},
    "name": {"const": "BALANCED64_V1"},
    "fp": {"type": "string", "minLength": 1},
    "wire_parameter_denominator": {"type": "integer", "minimum": 1},
    "window_count": {"const": 64},
    "positions_per_window": {"const": 1024},
    "positions": {"const": 65536},
    "support": {"const": 8192},
    "teacher_bank": {"const": "TEACHER_0731_BALANCED64_V2"},
    "teacher_source_model_index_sha256": {"$ref": "#/$defs/sha256"},
    "source_suite_sha256": {"$ref": "#/$defs/sha256"},
    "source_windows_sha256": {"$ref": "#/$defs/sha256"},
    "source_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "window_population_sha256": {"$ref": "#/$defs/sha256"},
    "class_map_sha256": {"$ref": "#/$defs/sha256"},
    "suite_lock_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization": {"type": "string", "minLength": 1},
    "retired_class_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "status"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "invalid-for-subgroup-reporting"}
      }
    },
    "class_windows": {"$ref": "#/$defs/classWindows"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "windows": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/window"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"],
      "properties": {
        "agentic": {"const": 19}, "chat": {"const": 7}, "code": {"const": 9},
        "multilingual": {"const": 10}, "prose": {"const": 10}, "reasoning": {"const": 9}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "window_id", "source_class"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
        "window_id": {"type": "integer", "minimum": 0},
        "source_class": {"enum": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"]}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kld", "top1"],
      "properties": {
        "kld": {
          "type": "object", "additionalProperties": false,
          "required": ["direction", "support", "per_position_dtype", "serialization", "reduction", "negative_policy"],
          "properties": {
            "direction": {"const": "KL(teacher||candidate)"},
            "support": {"type": "string", "minLength": 1},
            "per_position_dtype": {"const": "IEEE-754 binary64"},
            "serialization": {"type": "string", "minLength": 1},
            "reduction": {"type": "string", "minLength": 1},
            "negative_policy": {"type": "string", "minLength": 1}
          }
        },
        "top1": {
          "type": "object", "additionalProperties": false,
          "required": ["definition", "tie_break"],
          "properties": {
            "definition": {"type": "string", "minLength": 1},
            "tie_break": {"const": "deterministic first-index argmax"}
          }
        }
      }
    }
  }
}
