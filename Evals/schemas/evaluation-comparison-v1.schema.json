{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-other-github-account/banana-smasher/blob/main/evaluations/schemas/evaluation-comparison-v1.schema.json",
  "title": "Banana Smasher evaluation comparison receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "comparison_id", "title", "fp", "wire_parameter_denominator",
    "mtp_inclusive_parameter_denominator", "size_accounting",
    "suite", "metrics", "verification_scope", "results"
  ],
  "properties": {
    "schema": {"const": "banana-smasher.evaluation-comparison.v1"},
    "comparison_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "fp": {"type": "string", "minLength": 1},
    "wire_parameter_denominator": {"type": "integer", "minimum": 1},
    "mtp_inclusive_parameter_denominator": {"type": "integer", "minimum": 1},
    "size_accounting": {"$ref": "#/$defs/sizeAccounting"},
    "suite": {"$ref": "#/$defs/suiteProjection"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "verification_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["publicly_verifiable", "not_publicly_authenticated", "full_gpu_replay"],
      "properties": {
        "publicly_verifiable": {"type": "string", "minLength": 1},
        "not_publicly_authenticated": {"type": "string", "minLength": 1},
        "full_gpu_replay": {"type": "string", "minLength": 1}
      }
    },
    "results": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:e[+-]?[0-9]+)?$"},
    "sizeAccounting": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_path", "receipt_sha256", "comparison_bpw_kind", "matched_physical_bpw_kind"],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "comparison_bpw_kind": {"type": "string", "minLength": 1},
        "matched_physical_bpw_kind": {"type": "string", "minLength": 1}
      }
    },
    "suiteProjection": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "suite_lock_sha256", "source_suite_sha256", "source_windows_sha256",
        "source_provenance_sha256", "window_population_sha256", "class_map_sha256",
        "teacher_bank", "teacher_source_model_index_sha256", "windows",
        "positions_per_window", "positions", "support", "class_windows"
      ],
      "properties": {
        "name": {"const": "BALANCED64_V1"},
        "suite_lock_sha256": {"$ref": "#/$defs/sha256"},
        "source_suite_sha256": {"$ref": "#/$defs/sha256"},
        "source_windows_sha256": {"$ref": "#/$defs/sha256"},
        "source_provenance_sha256": {"$ref": "#/$defs/sha256"},
        "window_population_sha256": {"$ref": "#/$defs/sha256"},
        "class_map_sha256": {"$ref": "#/$defs/sha256"},
        "teacher_bank": {"type": "string", "minLength": 1},
        "teacher_source_model_index_sha256": {"$ref": "#/$defs/sha256"},
        "windows": {"const": 64}, "positions_per_window": {"const": 1024},
        "positions": {"const": 65536}, "support": {"const": 8192},
        "class_windows": {"$ref": "#/$defs/classWindows"}
      }
    },
    "classWindows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"],
      "properties": {
        "agentic": {"const": 19},
        "chat": {"const": 7},
        "code": {"const": 9},
        "multilingual": {"const": 10},
        "prose": {"const": 10},
        "reasoning": {"const": 9}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kld", "top1"],
      "properties": {
        "kld": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "support", "per_position_dtype", "serialization", "reduction", "negative_policy"],
          "properties": {
            "direction": {"const": "KL(teacher||candidate)"},
            "support": {"type": "string", "minLength": 1},
            "per_position_dtype": {"const": "IEEE-754 binary64"},
            "serialization": {"type": "string", "minLength": 1},
            "reduction": {"type": "string", "minLength": 1},
            "negative_policy": {"type": "string", "minLength": 1}
          }
        },
        "top1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "tie_break"],
          "properties": {
            "definition": {"type": "string", "minLength": 1},
            "tie_break": {"const": "deterministic first-index argmax"}
          }
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "role", "availability", "sha256"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "availability": {"const": "protected-not-distributed"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blockers"],
      "properties": {
        "status": {"const": "blocked"},
        "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "modelParameterComponents": {
      "type": "object", "additionalProperties": false,
      "required": ["base_model", "auxiliary_models"],
      "properties": {
        "base_model": {"type": "integer", "minimum": 1},
        "auxiliary_models": {"type": "integer", "minimum": 0}
      }
    },
    "wire": {
      "type": "object", "additionalProperties": false,
      "required": [
        "bytes", "decimal_gb", "artifact_payload_scope", "parameter_denominator", "normalized_bpw",
        "total_model_parameters", "total_model_parameter_components", "total_model_bpw"
      ],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "decimal_gb": {"$ref": "#/$defs/decimal"},
        "artifact_payload_scope": {
          "enum": ["base-model-only", "base-plus-native-mtp", "base-plus-partial-native-mtp", "base-plus-separate-drafter"],
          "description": "Declares whether exact shipping bytes exclude MTP, include the complete native MTP checkpoint, include a sealed historical partial native-MTP payload, or include a separately packaged drafter."
        },
        "parameter_denominator": {
          "type": "integer",
          "minimum": 1,
          "description": "Canonical base-model logical parameter count used for apples-to-apples comparison and publication BPW."
        },
        "normalized_bpw": {
          "$ref": "#/$defs/decimal",
          "description": "Legacy field name for base-equivalent comparison BPW: every shipped artifact byte times eight divided by the fixed base-model parameter_denominator. Extra MTP or drafter bytes receive no denominator credit."
        },
        "total_model_parameters": {
          "type": "integer", "minimum": 1,
          "description": "Parameters represented by artifact_payload_scope: base only, base plus native MTP, or base plus separate drafter."
        },
        "total_model_parameter_components": {"$ref": "#/$defs/modelParameterComponents"},
        "total_model_bpw": {
          "$ref": "#/$defs/decimal",
          "description": "Matched physical BPW: shipped bytes times eight divided by total_model_parameters. This is not a cross-row ranking while artifact payload scopes differ."
        }
      }
    },
    "kld": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "mean"],
      "properties": {
        "direction": {"const": "KL(teacher||candidate)"},
        "mean": {"$ref": "#/$defs/decimal"}
      }
    },
    "top1": {
      "type": "object", "additionalProperties": false,
      "required": ["matches", "positions", "rate"],
      "properties": {
        "matches": {"type": "integer", "minimum": 0},
        "positions": {"const": 65536},
        "rate": {"$ref": "#/$defs/decimal"}
      }
    },
    "artifactCommon": {
      "type": "object",
      "required": ["identity_status", "missing_identity_fields"],
      "properties": {
        "identity_status": {"enum": ["complete-as-recorded", "partial"]},
        "missing_identity_fields": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifactIq2": {
      "allOf": [
        {"$ref": "#/$defs/artifactCommon"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["identity_status", "missing_identity_fields", "repository", "revision", "variant", "artifact_manifest_sha256"],
          "properties": {
            "identity_status": {"const": "complete-as-recorded"},
            "missing_identity_fields": {"maxItems": 0},
            "repository": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "variant": {"type": "string", "minLength": 1},
            "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "artifactPartial": {
      "allOf": [
        {"$ref": "#/$defs/artifactCommon"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["identity_status", "missing_identity_fields", "base_model", "variant", "source_final_sha256"],
          "properties": {
            "identity_status": {"const": "partial"},
            "missing_identity_fields": {"minItems": 1},
            "base_model": {"type": "string", "minLength": 1},
            "variant": {"type": "string", "minLength": 1},
            "source_final_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "artifactExternal": {
      "allOf": [
        {"$ref": "#/$defs/artifactCommon"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "identity_status", "missing_identity_fields", "base_model", "variant",
            "format", "mechanism", "candidate_artifact_sha256",
            "candidate_manifest_sha256"
          ],
          "properties": {
            "identity_status": {"enum": ["complete-as-recorded", "partial"]},
            "missing_identity_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "base_model": {"const": "DeepSeek-V4-Flash-0731"},
            "variant": {"type": "string", "minLength": 1},
            "format": {"const": "EXL3"},
            "mechanism": {"type": "string", "minLength": 1},
            "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "upstream_repository": {"type": "string", "format": "uri", "minLength": 1},
            "upstream_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        {
          "if": {"properties": {"identity_status": {"const": "complete-as-recorded"}}},
          "then": {
            "required": ["upstream_repository", "upstream_revision"],
            "properties": {"missing_identity_fields": {"maxItems": 0}}
          },
          "else": {"properties": {"missing_identity_fields": {"minItems": 1}}}
        }
      ]
    },
    "artifactDwarf": {
      "allOf": [
        {"$ref": "#/$defs/artifactCommon"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "identity_status", "missing_identity_fields", "base_repository", "base_revision",
            "base_sha256", "drafter_repository", "drafter_revision", "drafter_sha256",
            "engine", "engine_commit"
          ],
          "properties": {
            "identity_status": {"const": "complete-as-recorded"},
            "missing_identity_fields": {"maxItems": 0},
            "base_repository": {"type": "string", "minLength": 1},
            "base_revision": {"type": "string", "minLength": 1},
            "base_sha256": {"$ref": "#/$defs/sha256"},
            "drafter_repository": {"type": "string", "minLength": 1},
            "drafter_revision": {"type": "string", "minLength": 1},
            "drafter_sha256": {"$ref": "#/$defs/sha256"},
            "engine": {"type": "string", "minLength": 1},
            "engine_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "artifactQtip": {
      "allOf": [
        {"$ref": "#/$defs/artifactCommon"},
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "identity_status", "missing_identity_fields", "base_model", "variant",
            "family", "geometry", "description", "layers", "units",
            "candidate_artifact_sha256"
          ],
          "properties": {
            "identity_status": {"const": "complete-as-recorded"},
            "missing_identity_fields": {"maxItems": 0},
            "base_model": {"const": "DeepSeek-V4-Flash-0731"},
            "variant": {"type": "string", "minLength": 1},
            "family": {"enum": ["QTIP2", "QTIP2.5", "QTIP3"]},
            "geometry": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "layers": {"const": 43},
            "units": {"const": 22016},
            "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "classMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["windows", "positions", "kld_mean", "top1_matches", "top1_rate"],
      "properties": {
        "windows": {"type": "integer", "minimum": 1},
        "positions": {"type": "integer", "minimum": 1},
        "kld_mean": {"$ref": "#/$defs/decimal"},
        "top1_matches": {"type": "integer", "minimum": 0},
        "top1_rate": {"$ref": "#/$defs/decimal"}
      }
    },
    "classes": {
      "type": "object", "additionalProperties": false,
      "required": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"],
      "properties": {
        "agentic": {"$ref": "#/$defs/classMetric"},
        "chat": {"$ref": "#/$defs/classMetric"},
        "code": {"$ref": "#/$defs/classMetric"},
        "multilingual": {"$ref": "#/$defs/classMetric"},
        "prose": {"$ref": "#/$defs/classMetric"},
        "reasoning": {"$ref": "#/$defs/classMetric"}
      }
    },
    "componentLedger": {
      "type": "object", "additionalProperties": false,
      "required": ["bytes", "components"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "components": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "weightComponents": {
      "type": "object", "additionalProperties": false,
      "required": [
        "qtip_expert_payload", "retained_non_routed_payload",
        "weight_pack_index_metadata", "mtp_accounting_correction", "repair_payload",
        "torch_container_inflation_bytes", "runtime_and_headroom_bytes"
      ],
      "properties": {
        "qtip_expert_payload": {"$ref": "#/$defs/componentLedger"},
        "retained_non_routed_payload": {"$ref": "#/$defs/componentLedger"},
        "weight_pack_index_metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["source_bytes", "source_sha256", "corrected_bytes", "corrected_index_materialized"],
          "properties": {
            "source_bytes": {"type": "integer", "minimum": 1},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "corrected_bytes": {"type": "integer", "minimum": 1},
            "corrected_index_materialized": {"const": false}
          }
        },
        "mtp_accounting_correction": {
          "type": "object", "additionalProperties": false,
          "required": [
            "missing_tensor_count", "missing_tensor_payload_bytes",
            "corrected_retained_tensor_count", "corrected_retained_payload_bytes",
            "accounting_receipt_sha256"
          ],
          "properties": {
            "missing_tensor_count": {"const": 10},
            "missing_tensor_payload_bytes": {"const": 33843220},
            "corrected_retained_tensor_count": {"const": 6279},
            "corrected_retained_payload_bytes": {"const": 19742640908},
            "accounting_receipt_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "repair_payload": {
          "type": "object", "additionalProperties": false,
          "required": ["bytes"],
          "properties": {"bytes": {"type": "integer", "minimum": 0}}
        },
        "torch_container_inflation_bytes": {"const": 0},
        "runtime_and_headroom_bytes": {"const": 0}
      }
    },
    "externalWeightComponents": {
      "type": "object", "additionalProperties": false,
      "required": [
        "quantized_eligible_payload", "format_retained_payload",
        "safetensors_container_bytes", "artifact_metadata_bytes",
        "repair_payload", "runtime_and_headroom_bytes"
      ],
      "properties": {
        "quantized_eligible_payload": {"$ref": "#/$defs/componentLedger"},
        "format_retained_payload": {"$ref": "#/$defs/componentLedger"},
        "safetensors_container_bytes": {"type": "integer", "minimum": 0},
        "artifact_metadata_bytes": {"type": "integer", "minimum": 0},
        "repair_payload": {
          "type": "object", "additionalProperties": false,
          "required": ["bytes"],
          "properties": {"bytes": {"type": "integer", "minimum": 0}}
        },
        "runtime_and_headroom_bytes": {"const": 0}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "candidate_artifact_sha256", "teacher_bank",
        "teacher_source_model_index_sha256", "scorer_source_sha256",
        "repository_commit", "suite_file_sha256", "window_population_sha256",
        "class_map_sha256", "windows", "positions", "support", "holdout_used",
        "fallback_used", "censoring_used", "numeric_semantics", "artifacts",
        "limitations"
      ],
      "properties": {
        "status": {"const": "PASS"},
        "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "teacher_bank": {"type": "string", "minLength": 1},
        "teacher_source_model_index_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_source_sha256": {"$ref": "#/$defs/sha256"},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "suite_file_sha256": {"$ref": "#/$defs/sha256"},
        "window_population_sha256": {"$ref": "#/$defs/sha256"},
        "class_map_sha256": {"$ref": "#/$defs/sha256"},
        "windows": {"const": 64},
        "positions": {"const": 65536},
        "support": {"const": 8192},
        "holdout_used": {"const": false},
        "fallback_used": {"const": false},
        "censoring_used": {"const": false},
        "numeric_semantics": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "object", "minProperties": 6,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "externalMeasurement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "candidate_artifact_sha256", "teacher_bank",
        "teacher_source_model_index_sha256", "scorer_source_sha256",
        "suite_file_sha256", "suite_lock_sha256", "window_population_sha256",
        "class_map_sha256", "windows", "positions", "support", "holdout_used",
        "fallback_used", "numeric_semantics", "artifacts", "limitations",
        "unavailable_fields"
      ],
      "properties": {
        "status": {"const": "PASS"},
        "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "teacher_bank": {"type": "string", "minLength": 1},
        "teacher_source_model_index_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_source_sha256": {"$ref": "#/$defs/sha256"},
        "suite_file_sha256": {"$ref": "#/$defs/sha256"},
        "suite_lock_sha256": {"$ref": "#/$defs/sha256"},
        "window_population_sha256": {"$ref": "#/$defs/sha256"},
        "class_map_sha256": {"$ref": "#/$defs/sha256"},
        "windows": {"const": 64},
        "positions": {"const": 65536},
        "support": {"const": 8192},
        "holdout_used": {"const": false},
        "fallback_used": {"const": false},
        "censoring_used": {"const": false},
        "numeric_semantics": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "object", "minProperties": 6,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "unavailable_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "display_name", "vendor", "fp", "artifact", "wire", "kld", "top1", "classes", "source_receipts", "replay"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "fp": {"type": "string", "minLength": 1},
        "artifact": {"oneOf": [
          {"$ref": "#/$defs/artifactIq2"}, {"$ref": "#/$defs/artifactPartial"},
          {"$ref": "#/$defs/artifactExternal"}, {"$ref": "#/$defs/artifactDwarf"},
          {"$ref": "#/$defs/artifactQtip"}
        ]},
        "wire": {"$ref": "#/$defs/wire"},
        "kld": {"$ref": "#/$defs/kld"},
        "top1": {"$ref": "#/$defs/top1"},
        "classes": {"$ref": "#/$defs/classes"},
        "weight_components": {"oneOf": [
          {"$ref": "#/$defs/weightComponents"},
          {"$ref": "#/$defs/externalWeightComponents"}
        ]},
        "measurement": {"oneOf": [
          {"$ref": "#/$defs/measurement"},
          {"$ref": "#/$defs/externalMeasurement"}
        ]},
        "source_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "replay": {"$ref": "#/$defs/replay"}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact": {"required": ["family"]}}},
          "then": {
            "required": ["weight_components", "measurement"],
            "properties": {
              "weight_components": {"$ref": "#/$defs/weightComponents"},
              "measurement": {"$ref": "#/$defs/measurement"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact": {
                "required": ["format", "upstream_repository", "upstream_revision"],
                "properties": {"identity_status": {"const": "complete-as-recorded"}}
              }
            }
          },
          "then": {
            "required": ["weight_components", "measurement"],
            "properties": {
              "weight_components": {"$ref": "#/$defs/externalWeightComponents"},
              "measurement": {
                "allOf": [
                  {"$ref": "#/$defs/externalMeasurement"},
                  {"required": ["censoring_used"]}
                ]
              }
            }
          }
        }
      ]
    }
  }
}
