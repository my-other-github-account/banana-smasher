{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-other-github-account/banana-smasher/blob/main/evaluations/schemas/balanced64-window-v1.schema.json",
  "title": "Banana Smasher BALANCED64 standardized window receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_lock_sha256",
    "teacher_source_model_index_sha256",
    "candidate_artifact_sha256",
    "ordinal",
    "window_id",
    "source_class",
    "positions",
    "kld_values",
    "top1_matches"
  ],
  "properties": {
    "schema": {"const": "banana-smasher.balanced64-window.v1"},
    "suite_lock_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_source_model_index_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "ordinal": {"type": "integer", "minimum": 0},
    "window_id": {"type": "integer", "minimum": 0},
    "source_class": {
      "enum": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"]
    },
    "positions": {"type": "integer", "minimum": 1},
    "kld_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:e[+-]?[0-9]+)?$"
      }
    },
    "top1_matches": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
