{
  "schema": "banana-smasher-qtip-ring-family-v2",
  "supported_bpw": {
    "min": "1.00",
    "max": "4.00",
    "step": "0.25"
  },
  "geometry_family": {
    "L": 16,
    "V": 2,
    "component_quarters": 4
  },
  "backends": [
    {
      "K": 1,
      "backend": "persistent-prefix-generic-aot-v1"
    },
    {
      "K": 2,
      "backend": "qtip-trellis-v2-graph-replay-b256-chunked-batch-exact-v46"
    },
    {
      "K": 3,
      "backend": "persistent-soa-exact-prefix-dp-v32"
    },
    {
      "K": 4,
      "backend": "persistent-prefix-generic-aot-v1"
    }
  ],
  "codebook": {
    "decode_mode": "quantlut_sym",
    "family": "bitshift",
    "pack_contract": {
      "dtype": "uint16",
      "input_tile": [16, 16],
      "output_rows": "input_tile_grid",
      "packed_words_per_tile_per_k": 16
    },
    "td_x": 16,
    "td_y": 16,
    "tlut_binding": "run-manifest",
    "tlut_bits": 9
  },
  "aot": {
    "architecture": "runtime-device",
    "cache": "sha256-pinned",
    "compile": "first-use-or-explicit",
    "producer": "smash kernels build --tier qtip --bpw {bpw}"
  }
}
