{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.local/schema/qtip25-codec-taxonomy-v1.schema.json",
  "title": "QTIP2.5 collision-free codec taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "codecs", "compatibility_aliases", "baseline_receipt", "immutability"],
  "properties": {
    "schema": {"const": "banana-smasher-qtip25-codec-taxonomy-v1"},
    "status": {"const": "PASS"},
    "codecs": {
      "const": [
        {
          "public_name": "QTIP2.5-AVG-MEMBER",
          "machine_id": "qtip25_avg_member",
          "codec_form": "avg_member_50_50",
          "runtime_family": "qtip2",
          "runtime_payload_families": ["qtip2", "qtip3"],
          "nominal_code_bpw": "2.5",
          "rate_num": 5,
          "rate_den": 2
        },
        {
          "public_name": "QTIP2.5-PERIODIC",
          "machine_id": "qtip25_periodic_23",
          "codec_form": "periodic_2_3",
          "runtime_family": "qtip2",
          "runtime_payload_families": ["qtip2", "qtip3"],
          "nominal_code_bpw": "2.5",
          "rate_num": 5,
          "rate_den": 2
        },
        {
          "public_name": "QTIP2.5-TWOSTEP",
          "machine_id": "qtip25_twostep_5b",
          "codec_form": "twostep_5b",
          "runtime_family": "qtip2",
          "runtime_payload_families": ["qtip2", "qtip3"],
          "nominal_code_bpw": "2.5",
          "rate_num": 5,
          "rate_den": 2
        }
      ]
    },
    "compatibility_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qtip@2.50"],
      "properties": {
        "qtip@2.50": {
          "const": {
            "machine_id": "qtip25_avg_member",
            "codec_form": "avg_member_50_50"
          }
        }
      }
    },
    "baseline_receipt": {"$ref": "#/$defs/file"},
    "immutability": {
      "const": {
        "legacy_alias_only": true,
        "sealed_ff0731_bytes_relabelled": false,
        "sealed_receipts_mutated": false
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
