{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.invalid/schema/banana-smasher-backpack-plan-v1.schema.json",
  "title": "Banana Smasher Backpack Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model", "target", "tiers", "anchor", "prediction", "repair", "output"],
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,126}[A-Za-z0-9])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "activation_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bytes", "sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/safe_id"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "vector_vq_bits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "dimension", "bits"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "vector_vq"},
        "provider": {"type": "string", "minLength": 1},
        "dimension": {"enum": [4, 8]},
        "bits": {"type": "integer", "minimum": 1, "maximum": 16},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "vector_vq_codebook_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "dimension", "codebook_size"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "vector_vq"},
        "provider": {"type": "string", "minLength": 1},
        "dimension": {"enum": [4, 8]},
        "codebook_size": {
          "enum": [
            2, 4, 8, 16, 32, 64, 128, 256,
            512, 1024, 2048, 4096, 8192, 16384, 32768, 65536
          ]
        },
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "vector_vq_bpw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "dimension", "bpw"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "vector_vq"},
        "provider": {"type": "string", "minLength": 1},
        "dimension": {"enum": [4, 8]},
        "bpw": {"type": "number"},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      },
      "allOf": [
        {
          "if": {"properties": {"dimension": {"const": 4}}},
          "then": {
            "properties": {
              "bpw": {
                "enum": [
                  0.25, 0.5, 0.75, 1.0,
                  1.25, 1.5, 1.75, 2.0,
                  2.25, 2.5, 2.75, 3.0,
                  3.25, 3.5, 3.75, 4.0
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"dimension": {"const": 8}}},
          "then": {
            "properties": {
              "bpw": {
                "enum": [
                  0.125, 0.25, 0.375, 0.5,
                  0.625, 0.75, 0.875, 1.0,
                  1.125, 1.25, 1.375, 1.5,
                  1.625, 1.75, 1.875, 2.0
                ]
              }
            }
          }
        }
      ]
    },
    "native_mxfp4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "native_mxfp4"},
        "provider": {"enum": ["native_mxfp4", "native-mxfp4"]},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "qtip_native_v7": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "bpw", "calibration"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "qtip"},
        "provider": {"enum": ["qtip2", "qtip2-v7", "qtip@2.00"]},
        "bpw": {"const": 2.0},
        "backend": {"const": "native_v7"},
        "calibration": {"$ref": "#/$defs/path"},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "qtip_packaged_default": {
      "type": "object",
      "additionalProperties": false,
      "not": {"properties": {"bpw": {"const": 2.0}}},
      "required": ["id", "family", "bpw", "source_root"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "qtip"},
        "provider": {
          "type": "string",
          "minLength": 1,
          "not": {"enum": ["qtip2", "qtip2-v7", "qtip@2.00"]}
        },
        "bpw": {"type": "number", "minimum": 1, "maximum": 4, "multipleOf": 0.25},
        "source_root": {"$ref": "#/$defs/path"},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "qtip_packaged_explicit": {
      "type": "object",
      "additionalProperties": false,
      "not": {"properties": {"bpw": {"const": 2.0}}},
      "required": ["id", "family", "bpw", "backend", "source_root"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "qtip"},
        "provider": {
          "type": "string",
          "minLength": 1,
          "not": {"enum": ["qtip2", "qtip2-v7", "qtip@2.00"]}
        },
        "bpw": {"type": "number", "minimum": 1, "maximum": 4, "multipleOf": 0.25},
        "backend": {"const": "packaged_qtip"},
        "source_root": {"$ref": "#/$defs/path"},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    },
    "qtip_fixture_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "bpw", "backend"],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "family": {"const": "qtip"},
        "provider": {
          "type": "string",
          "minLength": 1,
          "not": {"enum": ["qtip2", "qtip2-v7", "qtip@2.00"]}
        },
        "bpw": {"type": "number", "minimum": 1, "maximum": 4, "multipleOf": 0.25},
        "backend": {"const": "fixture_reference"},
        "activation_artifacts": {"$ref": "#/$defs/activation_artifacts"}
      }
    }
  },
  "properties": {
    "schema": {"const": "banana-smasher-backpack-plan-v1"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision"],
      "properties": {
        "root": {"$ref": "#/$defs/path"},
        "manifest": {"$ref": "#/$defs/path"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_bytes": {"type": "integer", "minimum": 1},
        "whole_model_bpw": {"type": "number", "exclusiveMinimum": 0}
      },
      "oneOf": [
        {
          "required": ["exact_bytes"],
          "not": {"required": ["whole_model_bpw"]}
        },
        {
          "required": ["whole_model_bpw"],
          "not": {"required": ["exact_bytes"]}
        }
      ]
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/vector_vq_bits"},
          {"$ref": "#/$defs/vector_vq_codebook_size"},
          {"$ref": "#/$defs/vector_vq_bpw"},
          {"$ref": "#/$defs/native_mxfp4"},
          {"$ref": "#/$defs/qtip_native_v7"},
          {"$ref": "#/$defs/qtip_packaged_default"},
          {"$ref": "#/$defs/qtip_packaged_explicit"},
          {"$ref": "#/$defs/qtip_fixture_reference"}
        ]
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank", "teacher"],
      "properties": {
        "bank": {"$ref": "#/$defs/path"},
        "teacher": {
          "anyOf": [
            {"const": "model"},
            {"$ref": "#/$defs/path"}
          ]
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_caps"],
      "properties": {
        "class_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"],
          "properties": {
            "agentic": {"type": "number", "exclusiveMinimum": 0},
            "chat": {"type": "number", "exclusiveMinimum": 0},
            "code": {"type": "number", "exclusiveMinimum": 0},
            "multilingual": {"type": "number", "exclusiveMinimum": 0},
            "prose": {"type": "number", "exclusiveMinimum": 0},
            "reasoning": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "repair": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {"const": "none"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "strength"],
          "properties": {
            "method": {"enum": ["residual", "fixture_residual"]},
            "strength": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "checkpoint",
            "checkpoint_sha256",
            "active_overlay",
            "active_overlay_sha256",
            "assignment",
            "assignment_sha256",
            "update"
          ],
          "properties": {
            "method": {"const": "repair_bundle"},
            "checkpoint": {"$ref": "#/$defs/path"},
            "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
            "active_overlay": {"$ref": "#/$defs/path"},
            "active_overlay_sha256": {"$ref": "#/$defs/sha256"},
            "assignment": {"$ref": "#/$defs/path"},
            "assignment_sha256": {"$ref": "#/$defs/sha256"},
            "update": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "reuse_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"$ref": "#/$defs/safe_id"},
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "admission": {"enum": ["admitted", "evidence_only"]},
          "schema": {"type": "string", "minLength": 1},
          "stage": {
            "enum": [
              "inspect",
              "candidates",
              "candidate_anchor",
              "pred",
              "solve_materialize",
              "pre_repair_anchor",
              "repair",
              "final_score"
            ]
          }
        },
        "allOf": [
          {
            "if": {"required": ["stage"]},
            "then": {
              "properties": {
                "schema": {"const": "banana-smasher-backpack-stage-receipt-v1"}
              },
              "required": ["schema"]
            }
          }
        ]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "model_id", "instance_id"],
      "properties": {
        "pack": {"$ref": "#/$defs/path"},
        "model_id": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "serving_model_root": {"$ref": "#/$defs/path"}
      }
    }
  }
}
