{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.invalid/schema/banana-smasher-mixed-backpack-config-v1.schema.json",
  "title": "Banana Smasher mixed Backpack config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "basis_sha256",
    "target",
    "fallback_tier",
    "dimensions",
    "class_caps"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dimension_source": {
      "oneOf": [
        {"$ref": "#/$defs/dimension_descriptor"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["locator_path"],
          "properties": {"locator_path": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "six_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentic", "chat", "code", "multilingual", "prose", "reasoning"],
      "properties": {
        "agentic": {"type": "number", "minimum": 0},
        "chat": {"type": "number", "minimum": 0},
        "code": {"type": "number", "minimum": 0},
        "multilingual": {"type": "number", "minimum": 0},
        "prose": {"type": "number", "minimum": 0},
        "reasoning": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema": {"const": "banana-smasher-mixed-backpack-config-v1"},
    "basis_sha256": {"$ref": "#/$defs/sha256"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whole_model_bytes", "fixed_nonexpert_bytes", "exact"],
      "properties": {
        "whole_model_bytes": {"type": "integer", "minimum": 1},
        "fixed_nonexpert_bytes": {"type": "integer", "minimum": 0},
        "exact": {"type": "boolean"}
      }
    },
    "allowed_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "default": ["native_mxfp4", "qtip3", "qtip2"],
      "items": {"type": "string", "minLength": 1}
    },
    "fallback_tier": {"type": "string", "minLength": 1},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "experts_per_layer", "projections"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "experts_per_layer": {"type": "integer", "minimum": 1},
        "projections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["down", "fused13"]}
        }
      }
    },
    "dimensions": {
      "oneOf": [
        {"$ref": "#/$defs/dimension_descriptor"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources"],
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/dimension_source"}
            }
          }
        }
      ]
    },
    "class_caps": {"$ref": "#/$defs/six_classes"},
    "class_weights": {"$ref": "#/$defs/six_classes"}
  }
}
