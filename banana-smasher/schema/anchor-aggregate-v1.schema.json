{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.dev/schema/anchor-aggregate-v1.schema.json",
  "title": "Banana Smasher anchor aggregate v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "bank_id",
    "bank_role",
    "candidate_id",
    "coverage",
    "evaluation_contract",
    "measured",
    "bindings",
    "raw_sha256"
  ],
  "properties": {
    "schema": {"const": "banana-smasher-anchor-aggregate-v1"},
    "status": {"const": "PASS"},
    "bank_id": {"type": "string", "minLength": 1},
    "bank_role": {
      "enum": ["train_balanced64", "train512", "holdout_balanced64", "holdout512"]
    },
    "candidate_id": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "pattern": "^[0-9]+/[0-9]+$"},
    "evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions", "tier_menus", "basis_sha256", "candidate_sha256", "teacher_sha256", "scorer_sha256"],
      "properties": {
        "dimensions": {},
        "tier_menus": {},
        "basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "teacher_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scorer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "measured": {
      "type": "object",
      "required": ["label", "global_mean_kld", "per_class_mean_kld"],
      "properties": {
        "label": {"const": "measured_on_bank"},
        "global_mean_kld": {"type": "number", "minimum": 0},
        "per_class_mean_kld": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "parent_estimates": {
      "type": "object",
      "required": ["label", "global_mean_kld", "per_class_mean_kld", "parent_class_counts", "calibration_sha256", "calibration_source"],
      "properties": {
        "label": {"const": "estimated_parent_not_measured"},
        "global_mean_kld": {"type": "number", "minimum": 0},
        "per_class_mean_kld": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "parent_class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "calibration_source": {"type": "object"}
      }
    },
    "bindings": {"type": "object"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
