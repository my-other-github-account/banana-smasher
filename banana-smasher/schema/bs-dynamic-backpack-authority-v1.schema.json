{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/my-other-github-account/banana-smasher/blob/main/banana-smasher/schema/bs-dynamic-backpack-authority-v1.schema.json",
  "title": "Dynamic Backpack dimension authority",
  "description": "Exact source references for per-candidate dimensions. The public runtime additionally requires every path to identify a readable non-symlink regular file whose bytes match sha256.",
  "type": "object",
  "required": [
    "six_class_predictions",
    "six_class_ceilings",
    "projection_correction",
    "physical_bytes",
    "routing_importance_sha256"
  ],
  "properties": {
    "six_class_predictions": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "six_class_ceilings": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "projection_correction": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "physical_bytes": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "routing_importance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
