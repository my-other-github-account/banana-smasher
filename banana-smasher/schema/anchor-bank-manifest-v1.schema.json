{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.dev/schema/anchor-bank-manifest-v1.schema.json",
  "title": "Banana Smasher bank manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bank_id",
    "role",
    "parent_corpus",
    "windows",
    "class_counts",
    "identities",
    "dataset_fields",
    "split_lineage",
    "creation",
    "relationships",
    "content_hashes"
  ],
  "properties": {
    "schema": {"const": "banana-smasher-bank-manifest-v1"},
    "bank_id": {"type": "string", "minLength": 1},
    "role": {
      "enum": [
        "train_balanced64",
        "train512",
        "holdout_balanced64",
        "holdout512"
      ]
    },
    "parent_corpus": {"$ref": "#/$defs/identity"},
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class"],
        "properties": {
          "id": {"type": ["integer", "string"]},
          "class": {"type": "string", "minLength": 1}
        }
      }
    },
    "class_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "identities": {
      "type": "object",
      "required": ["corpus", "tokenizer", "teacher", "scorer"],
      "additionalProperties": {"$ref": "#/$defs/identity"}
    },
    "dataset_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "class"],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1}
      }
    },
    "split_lineage": {
      "type": "object",
      "required": ["split", "parent_bank_id"],
      "properties": {
        "split": {"type": "string", "minLength": 1},
        "parent_bank_id": {"type": ["string", "null"]}
      }
    },
    "creation": {
      "type": "object",
      "required": ["method", "config"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "config": {"type": "object"}
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bank_id", "relation"],
        "properties": {
          "bank_id": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "minLength": 1}
        }
      }
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_sha256",
        "class_map_sha256",
        "manifest_payload_sha256"
      ],
      "properties": {
        "membership_sha256": {"$ref": "#/$defs/sha256"},
        "class_map_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sha256", "uri"],
          "properties": {
            "status": {"const": "resolved"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "uri": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "unresolved"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
